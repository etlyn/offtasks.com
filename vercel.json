{
  "installCommand": "yarn install --frozen-lockfile --production=false",
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/review-media/:file",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/review-media/:file",
      "destination": "https://storage.googleapis.com/etlyn_images/offtasks-review/:file"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
