# Disabled until isolated provider/hook/consent/grant checks and deployment are verified.
OFFTASK_MCP_ENABLED=false
OFFTASK_BIND_HOST=127.0.0.1
OFFTASK_PORT=4100
OFFTASK_MCP_RESOURCE=https://mcp.offtasks.invalid/mcp
OFFTASK_OAUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
OFFTASK_OAUTH_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
OFFTASK_OAUTH_CLIENT_IDS=REGISTERED_HOST_CLIENT_ID
# Optional actual provider scopes only; NOT offtask:read or offtask:write.
# Supabase OAuth access tokens may omit scope; use an empty value until verified.
OFFTASK_OAUTH_SCOPES=
OFFTASK_ALLOWED_HOSTS=mcp.offtasks.invalid
OFFTASK_CORS_ORIGINS=https://chatgpt.com
OFFTASK_SUPABASE_URL=https://PROJECT.supabase.co
OFFTASK_SUPABASE_SERVICE_ROLE_KEY=SERVER_SECRET_STORE_REFERENCE
OFFTASK_CURSOR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Built-in service-only offtask_oauth_check_grant RPC is the default.
# Optional independently verified external checker: set BOTH values to override.
OFFTASK_GRANT_CHECK_URL=
OFFTASK_GRANT_CHECK_CREDENTIAL=
# Set only to the exact portal-issued domain challenge when verification is needed.
OFFTASK_OPENAI_DOMAIN_CHALLENGE=
