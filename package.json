{
  "name": "offtasks-web-app",
  "version": "1.07",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sample": "node scripts/dev-sample.mjs",
    "build": "vite build",
    "postbuild": "node scripts/create-spa-route-copies.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:google-auth": "node --test test/google-auth.test.mjs",
    "test:delete-account": "rm -rf .test-dist/delete-account && tsc -p tsconfig.delete-account-tests.json && node --test .test-dist/delete-account/delete-account.test.js",
    "test:password-recovery": "rm -rf .test-dist/password-recovery && tsc -p tsconfig.password-recovery-tests.json && node --test .test-dist/password-recovery/test/password-recovery.test.js",
    "test:database": "node --test test/planner-database.test.mjs test/goal-logos-database.test.mjs test/web-reminders-database.test.mjs",
    "test:analytics": "node --test test/analytics-routes.test.mjs",
    "test:planner": "node --test test/planner-model.test.mjs",
    "test:privacy": "node --test test/privacy-policy.test.mjs",
    "test:chatgpt-connection": "node --test test/chatgpt-connection.test.mjs test/chatgpt-public-package.test.mjs",
    "test:codex": "yarn --cwd integrations/codex install --frozen-lockfile && yarn --cwd integrations/codex typecheck && yarn --cwd integrations/codex build && yarn --cwd integrations/codex test && node --test test/codex-*.test.mjs test/goal-workbench.test.mjs test/oauth-consent.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@etlyn/analytics": "file:vendor/etlyn-analytics-0.5.0-alpha.0.tgz",
    "@etlyn/etlyn-auth": "file:vendor/etlyn-etlyn-auth-0.1.0-alpha.5.tgz",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@supabase/supabase-js": "2.75.1",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "typescript": "^5.4.5",
    "vite": "6.3.5"
  }
}
